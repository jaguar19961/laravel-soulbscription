{
    "name": "jaguar19961/laravel-soulbscription",
    "description": "A straightforward interface to handle subscriptions and features consumption.",
    "keywords": [
        "jaguar19961",
        "laravel",
        "laravel-soulbscription",
        "subscriptions"
    ],
    "homepage": "https://github.com/jaguar19961/laravel-soulbscription",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucas Vinicius",
            "email": "lucasvinicius211@yahoo.com",
            "role": "Developer"
        },
        {
            "name": "Vadim"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "*"
    },
    "autoload": {
        "psr-4": {
            "Jaguar19961\\Soulbscription\\": "src",
            "Jaguar19961\\Soulbscription\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpcs --standard=phpcs.xml",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jaguar19961\\Soulbscription\\SoulbscriptionServiceProvider"
            ],
            "aliases": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
